//------- switch case---------------//
import java.util.*;
public class Main {
    public static void main(String [] args) {
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        switch(n)
        {
            case 1:
                System.out.println("cse");
                break;
            case 2:
                System.out.println("ece");
                break;
            case 3:
                System.out.println("eee");
                default:
                System.out.println("Invalid");
        }
    }
}
